<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Trip Details - Bhaccasyoniztas Beach Resort Website Template</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header }}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							{{#if message}}
							<p>{{message}}</p>
							{{else}}
							<h1>{{trip.name}}</h1>
							<img src="{{trip.image}}" alt="{{trip.name}}">
							<h2>Trip Code: {{trip.code}}</h2>
							<p>Start: {{trip.start}}</p>
							<p>Length: {{trip.length}} nights</p>
							<p>Resort: {{trip.resort}}</p>
							<p>Per Person: ${{trip.perPerson}}</p>
							{{{trip.description}}}
							{{/if}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
</body>
</html>
